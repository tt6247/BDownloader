<Window x:Class="BDownloader.Views.AccountsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="账号与登录 · BDownloader" Width="850" Height="620" MinWidth="800" MinHeight="620" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="#F4F6FA" FontFamily="Microsoft YaHei UI">
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,23"><TextBlock Text="账号与登录" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="连接你的账号，使用可访问的内容与画质。" FontSize="12" Foreground="#8491A5" Margin="0,8,0,0"/></StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="White" CornerRadius="12" Padding="23" BorderBrush="#E4EAF3" BorderThickness="1"><StackPanel><TextBlock Text="BILIBILI" Foreground="#2DA5CC" FontWeight="Bold" FontSize="10"/><DockPanel Margin="0,8,0,12"><TextBlock x:Name="BiliStatus" DockPanel.Dock="Right" FontSize="10" Foreground="#8A99AE" VerticalAlignment="Center"/><TextBlock Text="哔哩哔哩" FontSize="19" FontWeight="SemiBold"/></DockPanel><Border Width="152" Height="152" Background="#F5F8FC" CornerRadius="10" HorizontalAlignment="Center"><Grid><TextBlock x:Name="QrPlaceholder" Text="点击下方生成二维码" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Foreground="#91A1B7"/><Image x:Name="QrImage" Margin="7" Stretch="Uniform"/></Grid></Border><TextBlock x:Name="QrStatus" Text="使用哔哩哔哩客户端扫码登录" TextWrapping="Wrap" HorizontalAlignment="Center" FontSize="10" Foreground="#8A99AE" Margin="0,12,0,15"/><Button x:Name="QrButton" Content="生成 / 刷新二维码" Click="Qr_Click" Style="{StaticResource Primary}"/><Button Content="退出 B站登录" Click="BiliLogout_Click" Style="{StaticResource Quiet}" FontSize="11" Margin="0,5,0,0"/></StackPanel></Border>
   <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="23" BorderBrush="#E4EAF3" BorderThickness="1"><StackPanel><TextBlock Text="YOUTUBE" Foreground="#DE6767" FontWeight="Bold" FontSize="10"/><TextBlock Text="YouTube" FontSize="19" FontWeight="SemiBold" Margin="0,8,0,18"/><Border Background="#F5F8FC" CornerRadius="8" Padding="16"><TextBlock Text="在浏览器完成 Google 登录，再导入 Netscape 格式的 cookies.txt。公开内容也可匿名下载。" TextWrapping="Wrap" FontSize="12" LineHeight="22" Foreground="#75879F"/></Border><Button Content="打开 YouTube 登录  ↗" Click="YouTubeLogin_Click" Margin="0,20,0,10"/><Button Content="导入登录会话" Click="Import_Click" Style="{StaticResource Primary}"/><TextBlock x:Name="YouTubeStatus" TextWrapping="Wrap" FontSize="11" Foreground="#8A99AE" Margin="0,15,0,6"/><Button Content="退出 YouTube 登录" Click="YouTubeLogout_Click" Style="{StaticResource Quiet}" FontSize="11"/></StackPanel></Border>
  </Grid>
  <DockPanel Grid.Row="2" Margin="0,20,0,0"><Button Content="完成" DockPanel.Dock="Right" Click="Close_Click" Padding="22,8"/><TextBlock Text="登录会话仅保存在本机，按当前 Windows 用户加密。" VerticalAlignment="Center" Foreground="#94A1B4" FontSize="10"/></DockPanel>
 </Grid>
</Window>
