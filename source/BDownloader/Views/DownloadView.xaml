<UserControl x:Class="BDownloader.Views.DownloadView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F4F6FA" FontFamily="Microsoft YaHei UI">
 <Grid Margin="30,27,30,23">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="下载工作台" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="你想保存的内容，都在这里。" FontSize="12" Foreground="#8290A4" Margin="0,7,0,0"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock x:Name="AccountStatus" Foreground="#7F8EA4" FontSize="10" HorizontalAlignment="Right"/><Button Content="管理登录  ↗" Click="Accounts_Click" Style="{StaticResource Quiet}" HorizontalAlignment="Right" Padding="0,8,0,0" MinHeight="25"/></StackPanel></Grid>
  <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="20,18" BorderBrush="#E7ECF4" BorderThickness="1">
   <StackPanel><DockPanel Margin="0,0,0,13"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Border Background="#E9F8FF" CornerRadius="4" Padding="7,3" Margin="0,0,6,0"><TextBlock Text="BILIBILI" FontSize="9" FontWeight="Bold" Foreground="#299AC7"/></Border><Border Background="#FFF0EF" CornerRadius="4" Padding="7,3"><TextBlock Text="YOUTUBE" FontSize="9" FontWeight="Bold" Foreground="#D55D60"/></Border></StackPanel><TextBlock Text="添加下载链接" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
    <DockPanel><Button x:Name="ParseButton" Content="解析内容  →" DockPanel.Dock="Right" Click="Parse_Click" Style="{StaticResource Primary}" Margin="10,0,0,0" Padding="22,10"/><Grid><TextBox x:Name="UrlBox" KeyDown="UrlBox_KeyDown" MinHeight="42" ToolTip="支持哔哩哔哩与 YouTube 视频 / 播放列表"/><TextBlock Text="粘贴视频或播放列表链接，自动识别平台" Margin="13,0" VerticalAlignment="Center" Foreground="#A2ADBD" FontSize="12" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=UrlBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DockPanel>
    <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><TextBlock Text="快速体验" FontSize="10" Foreground="#9AA7B9" VerticalAlignment="Center" Margin="0,0,10,0"/><Button Content="B站播放列表 ↗" Click="BiliExample_Click" Style="{StaticResource Quiet}" MinHeight="24" Padding="5,3" FontSize="10"/><Button Content="YouTube 视频 ↗" Click="YouTubeExample_Click" Style="{StaticResource Quiet}" MinHeight="24" Padding="10,3" FontSize="10"/></StackPanel>
   </StackPanel>
  </Border>
  <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="20,15" BorderBrush="#E7ECF4" BorderThickness="1" Margin="0,13,0,13">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="185"/><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid x:Name="OptionsPanel" Grid.ColumnSpan="2"><Grid.ColumnDefinitions><ColumnDefinition Width="185"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,14,0"><TextBlock Text="下载内容" FontSize="10" Foreground="#8290A4" Margin="0,0,0,7"/><ComboBox x:Name="ModeBox" SelectedIndex="0" SelectionChanged="Mode_Changed"><ComboBoxItem Content="视频 + 音频"/><ComboBoxItem Content="仅视频 · 无声音"/><ComboBoxItem Content="仅音频 · M4A"/><ComboBoxItem Content="仅音频 · MP3"/></ComboBox></StackPanel><StackPanel Grid.Column="1" Margin="0,0,14,0"><TextBlock Text="最高画质" FontSize="10" Foreground="#8290A4" Margin="0,0,0,7"/><ComboBox x:Name="QualityBox" SelectedIndex="0"><ComboBoxItem Content="最佳画质"/><ComboBoxItem Content="2160p"/><ComboBoxItem Content="1440p"/><ComboBoxItem Content="1080p"/><ComboBoxItem Content="720p"/><ComboBoxItem Content="480p"/></ComboBox></StackPanel></Grid>
    <StackPanel Grid.Column="2"><TextBlock Text="保存位置" FontSize="10" Foreground="#8290A4" Margin="0,0,0,7"/><DockPanel><Button Content="选择…" Click="Folder_Click" DockPanel.Dock="Right" Margin="7,0,0,0" Padding="11,8"/><TextBox x:Name="OutputBox" ToolTip="下载保存目录" MinHeight="38" FontSize="11"/></DockPanel></StackPanel>
   </Grid>
  </Border>
  <Border Grid.Row="3" Background="White" CornerRadius="12" BorderBrush="#E7ECF4" BorderThickness="1" Padding="0,0,0,4">
   <Grid><Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="20,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="全选" Click="SelectAll_Click" Style="{StaticResource Quiet}" Padding="8,4" MinHeight="26" FontSize="11"/><Button Content="清空选择" Click="SelectNone_Click" Style="{StaticResource Quiet}" Padding="8,4" MinHeight="26" FontSize="11"/><Border BorderBrush="#E4EAF3" BorderThickness="1,0,0,0" Margin="9,6"/><Button x:Name="VerifyButton" Content="↻  重新校验" Click="Verify_Click" Style="{StaticResource Quiet}" Padding="6,4" MinHeight="26" FontSize="11"/></StackPanel><TextBlock x:Name="CollectionTitle" Text="下载列表" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel>
    <Grid Grid.Row="1"><DataGrid x:Name="EntriesGrid" Margin="12,0" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F0F3F8" Background="White" BorderThickness="0" RowHeight="43" SelectionMode="Extended" EnableRowVirtualization="True" RowBackground="White" AlternatingRowBackground="#FCFDFE" Foreground="#334963"><DataGrid.Columns><DataGridCheckBoxColumn Header="选择" Binding="{Binding Selected,UpdateSourceTrigger=PropertyChanged}" Width="48"/><DataGridTextColumn Header="#" Binding="{Binding Index}" Width="38" IsReadOnly="True"/><DataGridTextColumn Header="内容" Binding="{Binding Title}" Width="*" MinWidth="150" IsReadOnly="True"/><DataGridTextColumn Header="时长" Binding="{Binding Duration}" Width="77" IsReadOnly="True"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="122" IsReadOnly="True"/><DataGridTextColumn Header="进度" Binding="{Binding ProgressText}" Width="68" IsReadOnly="True"/></DataGrid.Columns><DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Detail}"/></Style></DataGrid.RowStyle></DataGrid>
     <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Margin="0,28,0,0"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items.Count,ElementName=EntriesGrid}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><Border Background="#EFF4FC" CornerRadius="18" Width="64" Height="64" HorizontalAlignment="Center"><TextBlock Text="↓" FontSize="32" Foreground="#8DA8D0" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="下一份收藏，从一个链接开始" FontSize="13" Foreground="#8392A8" HorizontalAlignment="Center" Margin="0,17,0,7"/><TextBlock Text="解析后可自由选择视频、音频或整个播放列表" FontSize="10" Foreground="#A7B1C1" HorizontalAlignment="Center"/></StackPanel>
    </Grid>
   </Grid>
  </Border>
  <StackPanel Grid.Row="4" Margin="0,17,0,0"><ProgressBar x:Name="OverallProgress" Height="4" Minimum="0" Maximum="100" Foreground="#60CDB0" Background="#E4EAF2" BorderThickness="0"/><DockPanel Margin="0,13,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="CancelButton" Content="暂停" Click="Cancel_Click" IsEnabled="False" Margin="0,0,9,0" Padding="18,10"/><Button x:Name="DownloadButton" Content="↓  下载选中 / 继续" Click="Download_Click" Style="{StaticResource Primary}" Padding="20,10"/></StackPanel><StackPanel VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock x:Name="StatusText" Text="准备就绪，等待添加链接" TextWrapping="Wrap" MaxHeight="40" FontSize="11"/><TextBlock Text="✓  完成后自动检查媒体完整性" FontSize="10" Foreground="#91A0B5" Margin="0,6,0,0"/></StackPanel></DockPanel></StackPanel>
 </Grid>
</UserControl>
